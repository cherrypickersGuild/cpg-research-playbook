{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cherryinthehaystack.com/schemas/harvest/taxonomy.v1.json",
  "title": "Topic taxonomy configuration (v1)",
  "description": "Shape of config/harvest/topics/<topic_slug>.v1.json. Every source object must independently carry all nine required fields — the documentation may group repeated values visually, the configuration may not, because a source is read on its own and an inherited value would be an unstated assumption.",

  "type": "object",
  "additionalProperties": true,
  "required": ["config_version", "topic", "topic_slug", "categories"],
  "properties": {
    "config_version": { "type": "integer", "minimum": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "topic_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },

    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["category", "category_slug", "description", "sources"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "category_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "precedence_rule_id": { "type": "string" },
          "notes": { "type": "string" },

          "relevance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "require_any": { "type": "array", "items": { "type": "string" } },
              "boost": { "type": "array", "items": { "type": "string" } },
              "exclude": { "type": "array", "items": { "type": "string" } }
            }
          },

          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/source" }
          }
        }
      }
    }
  },

  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "description": "A configured discovery source. All nine fields are required on every object — no inheritance, no defaults.",
      "required": ["source_id", "topic_slug", "category_slug", "adapter", "url",
                   "role", "max_candidates", "max_requests", "fixture_id"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "topic_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "adapter": { "type": "string", "enum": ["feed", "sitemap", "jsonapi", "seed", "model_search"] },
        "url": { "type": "string", "pattern": "^https?://" },
        "role": {
          "type": "string",
          "enum": ["discovery", "validation_seed"],
          "description": "discovery = expected to surface new items; validation_seed = an explicitly configured authoritative source used to prove the adapter works for a category with no good discovery feed."
        },
        "max_candidates": { "type": "integer", "minimum": 1 },
        "max_requests": { "type": "integer", "minimum": 1 },
        "fixture_id": { "type": "string", "pattern": "^fx_[a-z0-9_]+$" },

        "seed": {
          "type": "object",
          "additionalProperties": false,
          "description": "Only for adapter=seed. Depth is NOT configurable: it is hard-fixed at 1 in code, which is what keeps this a bounded index reader rather than a crawler.",
          "required": ["mode"],
          "properties": {
            "mode": { "type": "string", "enum": ["record", "index"] },
            "same_host_only": { "type": "boolean" },
            "path_prefix_allowlist": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Fails CLOSED: an empty list qualifies no child."
            },
            "max_children": { "type": "integer", "minimum": 1 }
          }
        },

        "jsonapi": {
          "type": "object",
          "additionalProperties": false,
          "description": "Only for adapter=jsonapi.",
          "required": ["items_path", "field_map"],
          "properties": {
            "items_path": { "type": "string" },
            "field_map": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "record field -> dotted path in the source item. Index segments are numeric, e.g. 'agencies.0.name'."
            }
          }
        }
      }
    }
  }
}
