{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cherryinthehaystack.com/schemas/harvest/run_manifest.v1.json",
  "title": "Run manifest (v1)",
  "description": "One per run. Records what was attempted, what each source returned, why any cell produced nothing, every cross-topic decision, and whether the run is eligible for publication. A zero-result is data; an error is data; the two are never conflated.",

  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "harvest_run_id", "mode", "started_at", "finished_at",
               "environment", "config", "cells", "source_preflight",
               "classification_decisions", "publication_eligible"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "harvest_run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9]+$" },
    "mode": { "type": "string", "enum": ["harvest", "smoke", "smoke_model", "refresh", "linkcheck", "migration"] },
    "started_at": { "type": "string" },
    "finished_at": { "type": ["string", "null"] },

    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "jsonschema_version", "platform"],
      "properties": {
        "python_version": { "type": "string" },
        "jsonschema_version": { "type": "string" },
        "platform": { "type": "string" },
        "python_unverified": {
          "type": "boolean",
          "description": "true when --allow-python-drift was used, i.e. the interpreter is outside the tested 3.13.x range."
        },
        "dependency_drift": { "type": "boolean" }
      }
    },

    "config": {
      "type": "object",
      "description": "Which config versions this run used, so an artifact can always be traced to the rules that produced it.",
      "properties": {
        "topics": { "type": "array", "items": { "type": "string" } },
        "policy_version": { "type": "integer" },
        "precedence_version": { "type": "integer" },
        "canonicalization_version": { "type": "integer" },
        "cross_topic_policy": { "type": "string", "enum": ["cross_reference", "multi_publish", "suppress", "link"] },
        "enrich": { "type": "boolean" },
        "bounds": { "type": "object" }
      }
    },

    "source_preflight": {
      "type": "array",
      "description": "Bounded re-check of every configured source at the start of a live run. Planning-time availability is never assumed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "result"],
        "properties": {
          "source_id": { "type": "string" },
          "url": { "type": "string" },
          "result": { "type": "string", "enum": ["ok", "adapter_error", "infrastructure_error"] },
          "reason": { "type": ["string", "null"] },
          "http_status": { "type": ["integer", "null"] },
          "content_type": { "type": ["string", "null"] },
          "robots_allowed": { "type": ["boolean", "null"] },
          "crawl_delay_sec": { "type": ["number", "null"] },
          "bytes": { "type": ["integer", "null"] },
          "elapsed_ms": { "type": ["integer", "null"] }
        }
      }
    },

    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cell_id", "topic_slug", "category_slug", "status"],
        "properties": {
          "cell_id": { "type": "string" },
          "topic_slug": { "type": "string" },
          "category_slug": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "zero_result", "adapter_error", "infrastructure_error", "skipped", "not_run"] },
          "zero_result_reason": {
            "type": ["string", "null"],
            "enum": [null, "no_items_in_window", "all_below_relevance_threshold",
                     "all_rejected_quality", "all_duplicates_of_existing",
                     "category_exclusion_applied"]
          },
          "error_reason": {
            "type": ["string", "null"],
            "enum": [null, "feed_parse_error", "unexpected_content_type", "empty_response",
                     "schema_mapping_failed", "response_too_large", "index_parse_failed",
                     "robots_denied", "http_timeout", "http_5xx", "dns_failure",
                     "lease_timeout", "budget_exhausted", "circuit_open", "preflight_failed"]
          },
          "candidates": { "type": "integer", "minimum": 0 },
          "accepted": { "type": "integer", "minimum": 0 },
          "rejected": { "type": "integer", "minimum": 0 },
          "requests_made": { "type": "integer", "minimum": 0 },
          "elapsed_sec": { "type": "number", "minimum": 0 },
          "adapters_used": { "type": "array", "items": { "type": "string" } },
          "promoted": { "type": "boolean", "description": "false when the worker died before promotion; merge ignores unpromoted cells." }
        }
      }
    },

    "classification_decisions": {
      "type": "array",
      "description": "One entry for EVERY content seen in more than one topic. Nothing is suppressed without a record here explaining why.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_id", "topics", "owner_topic", "policy_applied", "reason"],
        "properties": {
          "content_id": { "type": "string" },
          "topics": { "type": "array", "items": { "type": "string" } },
          "owner_topic": { "type": "string" },
          "policy_applied": { "type": "string", "enum": ["cross_reference", "multi_publish", "suppress", "link"] },
          "reason": { "type": "string" },
          "competing_categories": { "type": "array", "items": { "type": "object" } }
        }
      }
    },

    "rounds": {
      "type": "array",
      "description": "Adaptive scheduling. Round 1 is always the 12 configured cells; later rounds open bounded gap lanes only where a credible source exists. Optional: a run that never scheduled a second round omits this rather than writing an empty claim.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "lanes", "stop_reason"],
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "lanes": { "type": "array", "items": { "type": "string" } },
          "new_accepted": { "type": "integer", "minimum": 0 },
          "duplicate_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "stop_reason": {
            "type": ["string", "null"],
            "enum": [null, "max_rounds", "no_progress", "duplicate_rate", "budget_exhausted",
                     "all_targets_met", "no_credible_source"],
            "description": "no_credible_source is reported, never papered over: an unmet target with no source to fill it is an honest result."
          },
          "thresholds": {
            "type": "object",
            "description": "The acceptance thresholds in force for this round. Recorded so it is provable they never moved: the scheduler changes WHERE it looks, never WHAT is accepted.",
            "additionalProperties": false,
            "properties": {
              "min_relevance": { "type": "number" },
              "min_quality": { "type": "number" },
              "accept_composite": { "type": "number" }
            }
          }
        }
      }
    },

    "coverage": {
      "type": "array",
      "description": "Per (topic, category). The five reporting-state counts are mutually exclusive and sum EXACTLY to applicable_full_records; cross_reference rows are excluded from all of them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic_slug", "category_slug", "applicable_full_records", "states"],
        "properties": {
          "topic_slug": { "type": "string" },
          "category_slug": { "type": "string" },
          "applicable_full_records": { "type": "integer", "minimum": 0 },
          "states": {
            "type": "object",
            "additionalProperties": false,
            "required": ["facet_complete", "facet_partial", "unresolved",
                         "not_enriched", "unmapped_legacy_value"],
            "properties": {
              "facet_complete": { "type": "integer", "minimum": 0 },
              "facet_partial": { "type": "integer", "minimum": 0 },
              "unresolved": { "type": "integer", "minimum": 0 },
              "not_enriched": { "type": "integer", "minimum": 0 },
              "unmapped_legacy_value": { "type": "integer", "minimum": 0 }
            }
          },
          "publication_eligible_records": { "type": "integer", "minimum": 0 },
          "publication_withheld_records": { "type": "integer", "minimum": 0 },
          "gated": {
            "type": "boolean",
            "description": "false for case-studies and product-discovery: report-only in v1, so their states block nothing."
          },
          "axis_targets": {
            "type": "array",
            "description": "Target versus observed per axis value. A target is a scheduler HINT; an unmet one is reported as unmet, never met by lowering acceptance.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["axis", "slug", "target_min", "observed"],
              "properties": {
                "axis": { "enum": ["industry", "business_function", "use_case_type"] },
                "slug": { "type": "string" },
                "coverage_policy": { "enum": ["priority", "standard", "record_only"] },
                "target_min": { "type": "integer", "minimum": 0 },
                "observed": { "type": "integer", "minimum": 0 },
                "gap": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },

    "lane_quality": {
      "type": "array",
      "description": "Per discovery lane. Reported and NEVER fed back into classification: lane membership is provenance only, and a lane's terms become evidence only when independently found in the fetched document.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane_id"],
        "properties": {
          "lane_id": { "type": "string" },
          "axis": { "type": ["string", "null"] },
          "slug": { "type": ["string", "null"] },
          "candidates": { "type": "integer", "minimum": 0 },
          "accepted": { "type": "integer", "minimum": 0 },
          "acceptance_yield": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "duplicate_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "quality_rejection_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "label_agreement": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "label_mismatch_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },

    "request_accounting": {
      "type": "object",
      "description": "Logical fetch ownership is asserted; HTTP attempts are merely observed. Three lanes sharing a feed produce ONE source-fetch owner; a 301 plus one 503 retry on that feed still produces one owner and three attempts, with the budget charged 3.",
      "additionalProperties": false,
      "properties": {
        "source_fetch_owners": { "type": "integer", "minimum": 0 },
        "target_fetch_owners": { "type": "integer", "minimum": 0 },
        "extraction_owners": { "type": "integer", "minimum": 0 },
        "http_attempts": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "redirect_hops": { "type": "integer", "minimum": 0 },
        "conditional_revalidations": { "type": "integer", "minimum": 0 }
      }
    },

    "alias_conflicts_count": { "type": "integer", "minimum": 0 },
    "merges": {
      "type": "array",
      "description": "Authorized merges of two previously independent records. Only ever populated via a domain_migration rule or an alias established before the second record existed.",
      "items": { "type": "object" }
    },

    "publication_eligible": {
      "type": "boolean",
      "description": "false for smoke runs. `promote` refuses an ineligible run: a bounded smoke runs with enrichment disabled and deliberately produces unverified fields, so it is an infrastructure test, not publishable output."
    },
    "publication_ineligible_reason": { "type": ["string", "null"] },

    "budgets": {
      "type": "object",
      "description": "Observed against configured. Present so a run that hit a cap is visible rather than silently truncated.",
      "properties": {
        "total_requests": { "type": "integer" },
        "total_elapsed_sec": { "type": "number" },
        "budget_exhausted_cells": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
