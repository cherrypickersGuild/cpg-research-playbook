# Tarballs — release artifacts, not source. Individual files are committed instead.
*.tar.gz

# macOS / editor noise
.DS_Store
*.swp
*~

# Python bytecode caches (regenerated when scripts/tests run)
__pycache__/
*.pyc

# Transient per-run artifacts — regenerated every run; the persistent truth
# lives in state/ax_case_db.json, state/entity_registry.json, state/category_registry.json.
state/*.err
state/news_hits.json
state/news_case_db_*.json
state/news_entity_batch.json
state/harvest_*
state/logs/
state/backups/
# deterministic GitHub metadata cache — regenerated/refreshed per run, never committed.
# Sharded per topic for the parallel harvest (github_meta_cache_<topic>.json).
state/github_meta_cache.json
state/github_meta_cache_*.json
# advisory lane/union lock directories — runtime coordination only, never source
state/locks/
# unique temp files from the atomic write-then-rename steps; present only mid-write
state/.tmp_*
# Per-topic visited-URL ledger shards. Each parallel lane owns one; the union
# ledger state/visited_url_ledger.json remains the committed, persistent truth
# they are seeded from.
state/visited_url_ledger_*.json

# Matrix harvest (state/matrix/). The KEPT outputs are manifest.json, the
# per-cell query sets (queries_category#i_topic#j.json), the per-cell harvest
# files (category#i_topic#j.json) and the derived matrix_union.json — none of
# which are ignored. Every transient per-cell working file is dot-prefixed, so
# one rule covers them all: ledgers, attempted sets, hit batches, entity
# batches, raw model output, error logs, GitHub caches and temp files.
state/matrix/.*

# ax_case_harvest transient scratch files — listed explicitly (not a wildcard)
# so state/ax_case_harvest_registry.json (the persistent output) is never
# accidentally matched.
state/ax_case_harvest_hits.json
state/ax_case_harvest_batch.json
state/ax_case_harvest_attempted.json
state/ax_case_harvest.err
state/ax_case_harvest_raw_candidates.json
state/ax_case_harvest_raw_extract.json
schedule/logs/
/state/taxonomy_harvest/
